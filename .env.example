# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Auth ──────────────────────────────────────────────────────────────
# Public URL of this app — used by the auth callback to build email-verify
# and password-reset redirect URLs. In prod set to https://guestlistsocial.com.
# Also used by the standalone Proofer domain (postproofer.com) to build links
# back to the parent app (dashboard, client view, publish queue), since those
# surfaces aren't served on that domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Bot protection on auth forms ─────────────────────────────────────
# CAPTCHA provider gating sign-up / sign-in / reset. Default "turnstile".
# Set to "none" to run WITHOUT any CAPTCHA keys or Cloudflare account — the
# keyless layers (honeypot + timing + per-IP/per-email rate limiting) stay on.
# In "none" mode, turn on Supabase "Confirm email" so unverified bot accounts
# can't do anything, and leave the two TURNSTILE keys below unset.
# CAPTCHA_PROVIDER=none
#
# Turnstile keys (only needed when CAPTCHA_PROVIDER is "turnstile"). If unset,
# Turnstile is skipped in dev — but sign-up FAILS CLOSED once
# ENABLE_PUBLIC_SIGNUP=true, so set both before turning public sign-up on
# (unless you've set CAPTCHA_PROVIDER=none).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: only accept challenges solved on these hostnames (comma-separated),
# e.g. postproofer.com,www.postproofer.com. Defeats tokens farmed off-site.
# TURNSTILE_ALLOWED_HOSTNAMES=

# ── Meta Graph API (for ad sync + decision execution) ────────────────
META_ACCESS_TOKEN=EAAx...
META_AD_ACCOUNT_ID=act_123456789

# ── Meta Social Publishing (OAuth flow for connected accounts) ───────
META_SOCIAL_APP_ID=123456789
META_SOCIAL_APP_SECRET=abc...
META_SOCIAL_REDIRECT_URI=https://yourdomain.com/api/meta/callback
# Optional: Facebook Login for Business configuration id. Create it in the
# Meta app dashboard (Facebook Login for Business → Configurations), requesting
# the Page + Instagram assets and the same permissions the app uses. The
# connect flow shows a business asset picker so Pages owned by a Business
# Portfolio / New Pages Experience can be selected. A default configuration id
# is baked into the code; set this to override it, or to "off" to fall back to
# the classic scope-based login.
META_SOCIAL_LOGIN_CONFIG_ID=

# ── Cron jobs (Vercel Cron → /api/cron/*) ────────────────────────────
# Shared secret that authorises the scheduled-publish and other cron
# routes. Set this to any long random string in Vercel's project env and
# Vercel automatically sends it as `Authorization: Bearer <secret>` on every
# cron invocation. Strongly recommended in prod: without it the routes fall
# back to trusting Vercel's `x-vercel-cron` header alone, which is less
# explicit. If a cron route ever returns 401, this is the first thing to check.
# CRON_SECRET=

# Auto-publish tuning for /api/cron/publish-meta-queue (both optional):
#   PUBLISH_GRACE_HOURS   — how late (hours past its slot) a scheduled post may
#                           still be auto-sent before it's marked 'failed'.
#                           Absorbs cron/deploy downtime. Default 48.
#   MAX_AUTO_PUBLISH_BATCH — if a single run finds more than this many posts
#                           due at once, it publishes NOTHING and holds them
#                           for manual review (guards against a mass send in
#                           error). Default 50.
# PUBLISH_GRACE_HOURS=48
# MAX_AUTO_PUBLISH_BATCH=50

# ── Anthropic (decision engine, reviews, playbooks) ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Interactions (Instagram comment feed) ────────────────────────────
# Option A: Apify actor output URL
# Option B: your own /comments proxy endpoint
# Must return JSON with one of:
#   { comments: [{ id, text, username, timestamp, permalink? }, ...] }
#   { data: [...] }  or a bare array
# INTERACTION_IG_SOURCE_URL=https://your-proxy.example.com/comments
# INTERACTION_IG_SOURCE_AUTH_HEADER=Bearer your-token
# Comma-separated keywords to highlight in comments
# INTERACTION_IG_KEYWORDS=zanzibar,kendwa,nungwi,restaurant,lunch,dinner,smoothie,food

# ── Email (optional — for sending review digests to clients) ─────────
# SMTP_HOST=smtp.provider.com
# SMTP_PORT=587
# SMTP_USER=you@provider.com
# SMTP_PASS=secret
# SMTP_FROM=noreply@yourdomain.com

# ── Auth / access ───────────────────────────────────────────────────────────
# Comma-separated emails that get super-admin access (the owner-only Super
# admin page + the "invite someone to their own team" tool). Case-insensitive.
# If unset, defaults to oshi@guestlist.net.
SUPER_ADMIN_EMAILS=oshi@guestlist.net
# Set to "true" to enable public self-serve sign-up at /sign-up. Off by default.
ENABLE_PUBLIC_SIGNUP=false
